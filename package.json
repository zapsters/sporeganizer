{
	"name": "sporeganizer",
	"version": "0.5.4",
	"type": "module",
	"description": "A homework tracking and productivity app with a mushroom theme!",
	"author": "Erin Ballinger",
	"license": "ISC",
	"scripts": {
		"dev": "vite dev --open",
		"emulators:start": "firebase emulators:start",
		"emulators:stop": "npx kill-port 4000 8080 8085",
		"build": "vite build",
		"preview": "vite preview --open",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/adapter-cloudflare": "^6.0.1",
		"@sveltejs/kit": "^2.19.2",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/jquery": "^3.5.32",
		"@types/sanitize-html": "^2.13.0",
		"jquery": "^3.7.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"sass-embedded": "^1.86.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-preprocess": "^6.0.3",
		"svelte-preprocess-import-assets": "^1.1.0",
		"typescript": "^5.0.0",
		"vite": "^6.2.2",
		"vite-plugin-node-polyfills": "^0.23.0"
	},
	"dependencies": {
		"dompurify": "^3.2.4",
		"firebase": "^11.4.0",
		"firebase-admin": "^13.2.0"
	}
}
